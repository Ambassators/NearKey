{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "buildCommand": "npm test",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "{web,shared,public/downloads}/**"
    }
  },
  "rewrites": [{"source": "/(.*)", "destination": "/api/index"}]
}
