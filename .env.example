# Set these in Vercel > Project > Settings > Environment Variables.
# PUBLIC_ORIGIN must be the stable production domain, with no trailing slash.
PUBLIC_ORIGIN=https://your-project.vercel.app
DEMO_USERNAME=admin
DEMO_PASSWORD=
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-the-read-write-rest-token
NEARKEY_STATE_KEY=nearkey:production:v1
