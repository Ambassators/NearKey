<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Never migrate the phone token without its non-exportable local Keystore key. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
